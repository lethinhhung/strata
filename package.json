{
  "name": "strata-cli",
  "version": "0.1.0",
  "description": "A provider-agnostic runtime for specification-led feature implementation",
  "type": "module",
  "bin": {
    "strata": "./dist/src/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/src/*.test.js",
    "test:ci": "tsx --test src/*.test.ts",
    "lint": "eslint src",
    "start": "node dist/src/cli.js"
  },
  "dependencies": {
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.70.1"
  }
}
