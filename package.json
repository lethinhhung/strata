{
  "name": "strata-cli",
  "version": "0.2.0",
  "description": "Cost-efficient specification-led implementation with a strong AI coordinator and low-cost worker agents",
  "type": "module",
  "bin": {
    "strata": "./dist/src/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint src tests vitest.config.ts .eslintrc.cjs --ext .ts,.cjs --config .eslintrc.cjs",
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true,force:true})\" && tsc && chmod +x dist/src/cli.js",
    "typecheck": "tsc --project tsconfig.check.json",
    "start": "node dist/src/cli.js",
    "test": "vitest run"
  },
  "dependencies": {
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.18.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.5",
    "vitest": "4.1.11"
  },
  "overrides": {
    "vite": "8.0.12",
    "rolldown": "1.0.2"
  }
}
